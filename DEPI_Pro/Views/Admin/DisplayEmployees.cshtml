@model List<EmployeeStatusDto>
@{
    ViewData["Title"] = "Employees List";
}

<div class="pharma-card p-4 p-sm-5 animated-fade">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold tracking-tight mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i> Manage Employees
            </h1>
            <p class="text-muted small mb-0">View all registered employees and their active status within PharmaPro.</p>
            <a class="btn btn-outline-primary btn-sm mt-2" onclick="GetApprovedEmployees()">
                Approved
            </a>
            <a class="btn btn-outline-warning btn-sm mt-2" onclick="GetPendingEmployees()">
                Pending
            </a>
            <a class="btn btn-outline-secondary btn-sm mt-2" onclick="GetRejectedEmployees()">
                Rejected
            </a>
        </div>
        <div id="employeeCount" class="mt-3 mt-md-0">
            <span class="badge bg-primary px-3 py-2" style="font-size: 0.9rem; border-radius: 20px;">
                Total Employees: @Model.Count
            </span>
        </div>
    </div>

@if (Model == null || !Model.Any())
{
        <div class="alert alert-info text-center py-4 rounded-3">
            <i class="bi bi-info-circle display-4 d-block mb-3 text-info"></i>
            <p class="mb-0 fw-semibold">No registered employees found in the system.</p>
        </div>
}
else
{
        <div class="table-responsive">
            <table id="employeeTable" class="table align-middle">
                <thead>
                    <tr>
                        <th>
                            <i class="bi bi-card-text me-2"></i> Employee ID
                        </th>
                        <th>
                            <i class="bi bi-person me-2"></i> Full Name
                        </th>
                        <th>
                            <i class="bi bi-envelope me-2"></i> Email Address
                        </th>
                        <th>
                            <i class="bi bi-shield-check me-2"></i> Account Status
                        </th>
                        <th>
                            <i class="bi bi-pencil-square me-2"></i> Edit
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@employee.Id</td>
                            <td>@employee.Name</td>
                            <td class="text-muted">@employee.Email</td>
                            <td>
                                @if (employee.Status.ToString() == "Approved")
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-1" style="font-size: 0.85rem; border-radius: 6px; border: 1px solid rgba(25, 135, 84, 0.25);">
                                        <i class="bi bi-check-circle-fill me-1"></i> @employee.Status
                                    </span>
                                }
                                else if (employee.Status.ToString() == "Pending")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1" style="font-size: 0.85rem; border-radius: 6px; border: 1px solid rgba(255, 193, 7, 0.35);">
                                        <i class="bi bi-hourglass-split me-1"></i> @employee.Status
                                    </span>
                                }
                                @* else if (employee.Status.ToString() == "Rejected")
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis px-2 py-1" style="font-size: 0.85rem; border-radius: 6px; border: 1px solid rgba(108, 117, 125, 0.25);">
                                        <i class="bi bi-x-circle-fill me-1"></i> @employee.Status
                                    </span>
                                } *@

                            </td>
                            @* <td><a asp-action="EditEmployeeStatusAndRole" asp-route-email="@employee.Email" class="btn btn-primary">Edit</a></td> *@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
            }
    </div>

    @section Scripts {
        <script>
            function GetPendingEmployees()
            {
                          $.ajax({url: "/Admin/PendingEmployees",
                              method: "GET"
                          , success: function(result){
                          let count = result.length;
                      document.getElementById("employeeCount").innerHTML =`<span class="badge bg-primary px-3 py-2" style="font-size: 0.9rem; border-radius: 20px;">
        Total Employees: ${count}
                    </span>`;
                              let html =`<thead>
                        <tr>
                            <th>
                                <i class="bi bi-card-text me-2"></i> Employee ID
                            </th>
                            <th>
                                <i class="bi bi-person me-2"></i> Full Name
                            </th>
                            <th>
                                <i class="bi bi-envelope me-2"></i> Email Address
                            </th>
                            <th>
                                <i class="bi bi-shield-check me-2"></i> Account Status
                            </th>
                            <th>
                                <i class="bi bi-pencil-square me-2"></i> Edit
                            </th>
                        </tr>
                    </thead>
                    <tbody>`;
                    for (employee of result)
                    {
                        html+= `<tr>
                                <td class="fw-bold text-primary">${employee.id}</td>
                                <td>${employee.name}</td>
                                <td class="text-muted">${employee.email}</td>
                                <td>
                                 <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1" style="font-size: 0.85rem; border-radius: 6px; border: 1px solid rgba(108, 117, 125, 0.25);">
                                            <i class="bi bi-hourglass-split me-1"></i> ${employee.status}
                                        </span>
                                </td>
                                <td><a class="btn btn-primary" href="/Admin/EditEmployeeStatusAndRole?email=${employee.email}">Edit</a></td>
                            </tr>`;
                    }
                    html+=`</tbody>`;
                    document.getElementById("employeeTable").innerHTML = html;
                  }
            });
            }
            // I need to edit all the employee data not just role and satuts
            function GetApprovedEmployees(){
                $.ajax({url: "/Admin/ApprovedEmployees",
                              method: "GET"
                          , success: function(result){
