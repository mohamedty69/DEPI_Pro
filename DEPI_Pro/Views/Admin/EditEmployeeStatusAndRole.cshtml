@{
}
@model EditEmployeeRoleAndStatus

<div class="container">
    <h2>Edit Employee Role and Status</h2>
    <form asp-action="EditEmployeeStatusAndRole" method="post">
        <input type="hidden" asp-for="Email" />
        <div class="form-group">
            <label asp-for="Role"></label>
            <select asp-for="Role" class="form-control" style="width:100px">
                <option value="">@Model.Role</option>
                <option value="Admin">Admin</option>
                <option value="Employee">Employee</option>
                <option value="Manager">Manager</option>
                <!-- Add more roles as needed -->
            </select>
        </div>
        <div class=" form-group">
            <label asp-for="Status"></label>
            <select asp-for="Status" class="form-control" style="width:100px">
                <option value="">@Model.Status</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
                <!-- Add more statuses as needed -->
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>

    </form>
</div>